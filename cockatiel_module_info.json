      "aarch64": "target/release/cockatiel_reprimand",
      "arm": "target/release/cockatiel_reprimand"
    },
    "linux": {
      "x86_64": "target/release/cockatiel_reprimand",
      "aarch64": "target/release/cockatiel_reprimand",
      "arm": "target/release/cockatiel_reprimand"
    },
    "windows": {
