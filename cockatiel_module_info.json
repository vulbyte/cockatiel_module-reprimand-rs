      "aarch64": "target/release/cockatiel_reprimand.exe",
      "arm": "target/release/cockatiel_reprimand.exe"
    }
  },
  "price": 0,
  "min_rank": 0,
  "authority": 0,
  "build_command": "cargo",
  "build_flags": [
    "build",
    "--release"
  ],
  "credentials": [
